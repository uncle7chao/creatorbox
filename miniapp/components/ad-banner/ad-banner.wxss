/* 广告位 · Banner（橙金渐变 + 推广角标，与会员页视觉一致） */
.adb {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 26rpx;
  border-radius: var(--r-card);
  background: linear-gradient(135deg, #FFF6E8, #FFEFD4);
  border: 1rpx solid #F5DFB8;
  position: relative;
  overflow: hidden;
}
.adb-tag {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 16rpx;
  color: #B8874A;
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 12rpx;
  border-radius: 0 0 0 10rpx;
}
.adb-body { flex: 1; min-width: 0; }
.adb-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #7A4A08;
}
.adb-s {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #B49B72;
}
.adb-go {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(232, 137, 12, 0.3);
}
.adb-arrow {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 11rpx solid #fff;
  margin-left: 4rpx;
}
.adb-hover { opacity: 0.8; }

/* 自定义图片广告（后台上传；≥2 张时走 .adb-swiper 轮播） */
.adb-swiper {
  margin: 20rpx 24rpx 0;
  height: 160rpx;
  border-radius: var(--r-card, 24rpx);
  overflow: hidden;
}
.adb-swiper .adb-img-wrap {
  margin: 0;
  height: 100%;
}
.adb-img-wrap {
  position: relative;
  margin: 20rpx 24rpx 0;
  border-radius: var(--r-card, 24rpx);
  overflow: hidden;
}

.adb-img {
  width: 100%;
  height: 160rpx;
  display: block;
}

/* 兜底卡轮播（首页默认推广帧，沿用 banner-swiper 视觉） */
.slide {
  display: flex;
  align-items: center;
  height: 160rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  border-radius: var(--r-card, 24rpx);
  position: relative;
  overflow: hidden;
  margin: 0;
}
.slide.g1 { background: linear-gradient(135deg, #FFF6E8, #FFE3B8); }
.slide.g2 { background: linear-gradient(135deg, #EAF4FF, #D2E7FF); }
.slide.g3 { background: linear-gradient(135deg, #EFFFE9, #D5F5C8); }
.slide-hover { opacity: 0.85; }
.s-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.25);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.slide.g1 .s-tag { background: #E8890C; }
.slide.g2 .s-tag { background: #4A90D9; }
.slide.g3 .s-tag { background: #5BAE3E; }
.s-body { flex: 1; min-width: 0; }
.s-t { font-size: 28rpx; font-weight: 700; color: #3a3a3a; }
.s-sub { margin-top: 4rpx; font-size: 20rpx; color: #8a8a8a; }
.s-go {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}
.s-arrow {
  width: 0;
  height: 0;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  border-left: 10rpx solid #B8874A;
  margin-left: 3rpx;
}
