<view class="page theme-{{theme}}">
  <theme-deco theme="{{theme}}" />

  <!-- ══ 用户卡（个人中心头部：身份 + 会员状态）══ -->
  <view class="user-card">
    <view class="uc-avatar">
      <image class="uc-avatar-ic" src="/images/tabbar/member_on.png" mode="aspectFit" />
    </view>
    <view class="uc-info">
      <view class="uc-name">CreatorBox 用户</view>
      <view class="uc-sub">素材与偏好已自动同步</view>
    </view>
    <view class="uc-badge {{isMember ? 'uc-badge-on' : ''}}">
      {{isMember ? '会员生效中' : '未开通'}}
    </view>
  </view>

  <!-- ══ 金色会员大卡（参考竞品：状态+价格+速览+开通一体）══ -->
  <view class="vip-card">
    <view class="vc-top">
      <view class="vc-brand">
        <view class="vc-crown"></view>
        <text class="vc-name">CreatorBox 会员</text>
      </view>
      <view class="vc-badge">不自动续费</view>
    </view>
    <view class="vc-price">
      <text class="vc-cur">¥</text><text class="vc-num">{{price}}</text><text class="vc-unit">/ 月</text>
    </view>
    <view class="vc-sub">一次付费，批量处理整条素材 · 可随时取消</view>
    <button wx:if="{{!isMember}}" class="vc-btn" bindtap="onBuy">立即开通</button>
    <view wx:else class="vc-vip">
      <view class="vc-vip-dot"></view>
      <text>已是会员 · 权益生效中</text>
    </view>
  </view>

  <!-- ══ 会员特权（参考竞品「更多免费工具」图标网格卡）══ -->
  <view class="sec">
    <view class="sec-h">会员特权<text class="cnt-tag">开通即享</text></view>
    <view class="perk-grid">
      <view wx:for="{{perks}}" wx:key="name" class="perk">
        <view class="pk-tile pk-{{item.cls}}">
          <!-- 皮肤专属图形（dark/sakura 逐个定制） -->
          <view wx:if="{{theme === 'dark' || theme === 'jade'}}" class="sk sk-d-{{item.cls}}"></view>
          <view wx:elif="{{theme === 'sakura'}}" class="sk sk-s-{{item.cls}}"></view>
          <!-- 批量：三条层叠 -->
          <view wx:elif="{{item.cls === 'batch'}}" class="gl-layers">
            <view class="l1"></view><view class="l2"></view><view class="l3"></view>
          </view>
          <!-- 高清：钻石 -->
          <view wx:elif="{{item.cls === 'hd'}}" class="gl-diamond"></view>
          <!-- 不限次：下载箭头 -->
          <view wx:elif="{{item.cls === 'save'}}" class="gl-dl">
            <view class="stem"></view><view class="head"></view><view class="tray"></view>
          </view>
          <!-- 云端：云朵 -->
          <view wx:elif="{{item.cls === 'cloud'}}" class="gl-cloud">
            <view class="c1"></view><view class="c2"></view><view class="base"></view>
          </view>
          <!-- 优先：闪电 -->
          <view wx:else class="gl-bolt"></view>
        </view>
        <view class="pk-name">{{item.name}}</view>
        <view class="pk-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- ══ 功能列表（个人中心主入口）══ -->
  <view class="menu-card">
    <view class="mi" bindtap="navLibrary" hover-class="mi-hover">
      <view class="mi-ic mi-lib"></view>
      <view class="mi-t">我的素材</view>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="navRanking" hover-class="mi-hover">
      <view class="mi-ic mi-rank"></view>
      <view class="mi-t">热门榜单</view>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="navPoints" hover-class="mi-hover">
      <view class="mi-ic mi-point"></view>
      <view class="mi-t">积分中心</view>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="onRedeemCode" hover-class="mi-hover">
      <view class="mi-ic mi-code"></view>
      <view class="mi-t">卡密兑换</view>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="onBridgeBind" hover-class="mi-hover">
      <view class="mi-ic mi-bridge"></view>
      <view class="mi-t">跨端绑定</view>
      <text class="mi-note">电脑 / App 同账号</text>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="onOrders" hover-class="mi-hover">
      <view class="mi-ic mi-order"></view>
      <view class="mi-t">订单记录</view>
      <text class="mi-note">支付开放后可用</text>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="onRestore" hover-class="mi-hover">
      <view class="mi-ic mi-restore"></view>
      <view class="mi-t">恢复购买</view>
      <view class="mi-arrow"></view>
    </view>
    <view class="mi" bindtap="navCompliance" hover-class="mi-hover">
      <view class="mi-ic mi-rule"></view>
      <view class="mi-t">使用规范</view>
      <view class="mi-arrow"></view>
    </view>
  </view>

  <!-- ══ 广告位（后台可开关；参考竞品同位）══ -->
  <ad-banner placement="member_banner" />

  <!-- ══ 皮肤切换（外观设置；三套预置，实时生效）══ -->
  <view class="skin-sec">
    <view class="skin-title">外观</view>
    <view class="skin-row">
      <view wx:for="{{themeList}}" wx:key="key"
            class="skin-card {{theme === item.key ? 'skin-on' : ''}}"
            data-key="{{item.key}}" bindtap="onPickTheme">
        <view class="skin-dot {{item.key}}"></view>
        <view class="skin-name">{{item.name}}</view>
        <view wx:if="{{theme === item.key}}" class="skin-check">使用中</view>
      </view>
    </view>
  </view>

  <!-- ══ 账号安全（隐私保护指引 §四 删除权）══ -->
  <view class="sec">
    <view class="sec-h">账号安全</view>

    <view class="mi" bindtap="onPurgePreview">
      <view class="mi-ic mi-danger"></view>
      <view class="mi-body">
        <view class="mi-t">注销账号</view>
        <view class="mi-s">删除全部个人数据，不可恢复</view>
      </view>
      <view class="mi-arrow"></view>
    </view>

    <view class="danger-note">
      注销后将同时清除：解析记录、素材库、配额、签到积分、跨端绑定身份与登录凭证。
      卡密库、违禁词库等平台运营数据不受影响。
    </view>
  </view>

  <view class="disclaimer" bindtap="navCompliance">
    开通即表示同意《会员服务协议》，可随时取消
  </view>
</view>
