@import "../../styles/skin-icons.wxss";
/* ══ 会员中心（参考竞品改造：金卡 + 特权网格 + 广告位）══
   颜色走皮肤变量；会员大卡用 hero 锚点色（随皮肤深浅但保持「深卡金字」识别） */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 60rpx;
}

/* ── 金色会员大卡 ── */
.vip-card {
  margin: 24rpx;
  padding: 40rpx 36rpx 36rpx;
  border-radius: var(--r-card);
  background:
    radial-gradient(ellipse 400rpx 220rpx at 88% -10%, var(--glow-soft), transparent 65%),
    linear-gradient(160deg, var(--hero-a2) 0%, var(--hero-a) 60%, var(--hero-b) 100%);
  box-shadow: 0 12rpx 32rpx rgba(61, 32, 0, 0.25);
  position: relative;
  overflow: hidden;
}
.vc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.vc-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vc-crown {
  width: 34rpx;
  height: 24rpx;
  background: var(--brand-3);
  clip-path: polygon(0 100%, 0 30%, 25% 65%, 50% 0, 75% 65%, 100% 30%, 100% 100%);
}
.vc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-3);
  letter-spacing: 1rpx;
}
.vc-badge {
  font-size: 18rpx;
  color: var(--brand-3);
  border: 1rpx solid var(--brand-3);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.vc-price {
  margin-top: 26rpx;
  color: #FFFFFF;
  display: flex;
  align-items: baseline;
}
.vc-cur { font-size: 30rpx; font-weight: 600; }
.vc-num {
  font-size: 76rpx;
  font-weight: 700;
  margin: 0 6rpx;
  background: linear-gradient(135deg, var(--brand-3), var(--brand-2));
  -webkit-background-clip: text;
  color: transparent;
}
.vc-unit { font-size: 24rpx; color: rgba(255, 255, 255, 0.6); }
.vc-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}
.vc-btn {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2A1B0C;
  background: linear-gradient(135deg, var(--brand-3), var(--brand-2));
  box-shadow: 0 8rpx 24rpx rgba(232, 137, 12, 0.4);
  border: 0;
}
.vc-vip {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--brand-3);
}
.vc-vip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-3);
}

/* ── 会员特权网格 ── */
.sec { margin: var(--sec-gap) 24rpx 0; }
.sec-h {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-900);
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.cnt-tag {
  font-size: 18rpx;
  color: var(--brand-ink);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.perk-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.perk {
  background: var(--bg-card);
  border-radius: var(--r-card);
  padding: 26rpx var(--card-pad) 22rpx;
  box-shadow: var(--card-shadow);
  border: var(--card-line) solid var(--line);
}
.pk-tile {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-3), var(--brand));
  box-shadow: 0 6rpx 16rpx rgba(232, 137, 12, 0.25);
}
.pk-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.pk-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-500);
}

/* 特权图形（纯 CSS，白色，适配渐变底） */
.gl-layers { position: relative; width: 30rpx; height: 28rpx; }
.gl-layers .l1 { position: absolute; left: 3rpx; top: 19rpx; width: 24rpx; height: 5rpx; background: rgba(255,255,255,.55); border-radius: 3rpx; }
.gl-layers .l2 { position: absolute; left: 3rpx; top: 12rpx; width: 24rpx; height: 5rpx; background: rgba(255,255,255,.8); border-radius: 3rpx; }
.gl-layers .l3 { position: absolute; left: 3rpx; top: 5rpx; width: 24rpx; height: 5rpx; background: #fff; border-radius: 3rpx; }

.gl-diamond {
  width: 30rpx;
  height: 30rpx;
  background: #fff;
  clip-path: polygon(50% 0, 100% 38%, 50% 100%, 0 38%);
}

.gl-dl { position: relative; width: 32rpx; height: 32rpx; }
.gl-dl .stem { position: absolute; left: 50%; top: 2rpx; transform: translateX(-50%); width: 5rpx; height: 13rpx; background: #fff; border-radius: 3rpx; }
.gl-dl .head { position: absolute; left: 50%; top: 13rpx; transform: translateX(-50%); width: 0; height: 0; border-left: 9rpx solid transparent; border-right: 9rpx solid transparent; border-top: 10rpx solid #fff; }
.gl-dl .tray { position: absolute; left: 2rpx; bottom: 3rpx; width: 28rpx; height: 5rpx; background: #fff; border-radius: 3rpx; }

.gl-cloud { position: relative; width: 34rpx; height: 24rpx; }
.gl-cloud .c1 { position: absolute; left: 4rpx; top: 4rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #fff; }
.gl-cloud .c2 { position: absolute; right: 2rpx; top: 7rpx; width: 11rpx; height: 11rpx; border-radius: 50%; background: #fff; }
.gl-cloud .base { position: absolute; left: 2rpx; bottom: 2rpx; width: 30rpx; height: 10rpx; border-radius: 6rpx; background: #fff; }

.gl-bolt {
  width: 22rpx;
  height: 32rpx;
  background: #fff;
  clip-path: polygon(58% 0, 12% 55%, 44% 55%, 38% 100%, 90% 40%, 55% 40%);
}

/* ── 免费对比条 ── */
.free-strip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fs-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-500);
  background: var(--bg-soft);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.fs-text {
  font-size: 22rpx;
  color: var(--ink-700);
}

/* ── 琥珀说服条 ── */
.amber {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--r-small);
  font-size: 22rpx;
  color: var(--brand-ink);
  background: var(--brand-soft);
  line-height: 1.6;
}

.links {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-500);
  margin-top: 40rpx;
}

/* ══ 皮肤切换（外观）══ */
.skin-sec {
  margin: 28rpx 24rpx 0;
  padding: 24rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
}
.skin-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.skin-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.skin-card {
  flex: 1;
  border: 2rpx solid var(--line);
  border-radius: var(--r-small);
  padding: 18rpx 0 14rpx;
  text-align: center;
  position: relative;
}
.skin-card.skin-on {
  border-color: var(--brand);
  box-shadow: 0 4rpx 14rpx rgba(232, 137, 12, 0.15);
}
.skin-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin: 0 auto;
}
.skin-dot.classic {
  background: linear-gradient(135deg, #F2C879, #D97A26);
}
.skin-dot.dark {
  background: linear-gradient(135deg, #2A2A31, #0E0E11);
  border: 1rpx solid #4A423C;
}
.skin-dot.sakura {
  background: linear-gradient(135deg, #FFA8C4, #E85D8F);
}
.skin-dot.jade {
  background: linear-gradient(135deg, #2E9E7B, #0C1210);
}
.skin-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-700);
}
.skin-check {
  font-size: 18rpx;
  color: var(--brand);
}

.disclaimer {
  margin: 28rpx 48rpx 0;
  font-size: 22rpx;
  color: var(--ink-300);
  line-height: 1.7;
  text-align: center;
}

/* ══ 用户卡（个人中心头部）══ */
.user-card {
  margin: 24rpx 24rpx 0;
  padding: 30rpx 28rpx;
  border-radius: var(--r-card);
  background: linear-gradient(135deg, var(--hero-a), var(--hero-a2));
  display: flex;
  align-items: center;
  border: var(--card-line) solid var(--line);
}

.uc-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.uc-avatar-ic {
  width: 52rpx;
  height: 52rpx;
}

.uc-info {
  flex: 1;
  margin-left: 22rpx;
}

.uc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.uc-sub {
  font-size: 22rpx;
  color: var(--brand-3);
  margin-top: 6rpx;
}

.uc-badge {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.uc-badge-on {
  color: var(--brand-3);
  border-color: var(--brand-3);
}

/* ══ 功能列表 ══ */
.menu-card {
  margin: var(--sec-gap) 24rpx 0;
  background: var(--bg-card);
  border-radius: var(--r-card);
  border: var(--card-line) solid var(--line);
  box-shadow: var(--card-shadow);
  overflow: hidden;
}

.mi {
  display: flex;
  align-items: center;
  padding: 28rpx 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.mi:last-child {
  border-bottom: none;
}

.mi-hover {
  background: var(--bg-soft);
}

.mi-ic {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  position: relative;
  flex-shrink: 0;
  background: var(--brand-soft);
}

/* 图标：语义化 CSS 小图形 */
.mi-lib {  /* 素材：文件夹 */
  background: var(--brand-soft);
}
.mi-lib::before {
  content: '';
  position: absolute;
  left: 5rpx; top: 8rpx;
  width: 24rpx; height: 18rpx;
  background: var(--brand);
  border-radius: 3rpx 3rpx 0 0;
}
.mi-lib::after {
  content: '';
  position: absolute;
  left: 5rpx; top: 13rpx;
  width: 24rpx; height: 12rpx;
  background: var(--brand);
  border-radius: 2rpx;
}

.mi-rank {  /* 榜单：三柱 */
  background: var(--brand-soft);
}
.mi-rank::before {
  content: '';
  position: absolute;
  left: 6rpx; bottom: 7rpx;
  width: 6rpx; height: 12rpx;
  background: var(--brand);
  border-radius: 1rpx;
}
.mi-rank::after {
  content: '';
  position: absolute;
  right: 6rpx; bottom: 7rpx;
  width: 6rpx; height: 20rpx;
  background: var(--brand);
  border-radius: 1rpx;
  box-shadow: -10rpx 0 0 var(--brand-2);
}

.mi-order {  /* 订单：单据（矩形 + 两行） */
  background: var(--brand-soft);
}
.mi-order::before {
  content: '';
  position: absolute;
  inset: 6rpx;
  border: 2rpx solid var(--brand);
  border-radius: 4rpx;
}
.mi-order::after {
  content: '';
  position: absolute;
  left: 10rpx; top: 12rpx;
  width: 14rpx; height: 2rpx;
  background: var(--brand);
  box-shadow: 0 6rpx 0 var(--brand);
}

.mi-restore {  /* 恢复：循环箭头（圆环 + 缺口） */
  background: var(--brand-soft);
}
.mi-restore::before {
  content: '';
  position: absolute;
  inset: 7rpx;
  border: 3rpx solid var(--brand);
  border-radius: 50%;
  border-left-color: transparent;
}

.mi-rule {  /* 规范：盾牌 */
  background: var(--brand-soft);
}
.mi-rule::before {
  content: '';
  position: absolute;
  left: 8rpx; top: 5rpx;
  width: 18rpx; height: 20rpx;
  background: var(--brand);
  border-radius: 4rpx 4rpx 10rpx 10rpx;
  clip-path: polygon(0 0, 100% 0, 100% 65%, 50% 100%, 0 65%);
}

.mi-t {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink-900);
}

.mi-note {
  font-size: 20rpx;
  color: var(--ink-300);
  margin-right: 12rpx;
}

.mi-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--ink-300);
  border-right: 3rpx solid var(--ink-300);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 积分：圆币（圆环 + 中缝） */
.mi-point { background: var(--brand-soft); }

/* 跨端绑定：两环相扣（2026-10-11） */
.mi-bridge {
  border: 3rpx solid var(--ink-700, #555);
  border-radius: 50%;
  position: relative;
}
.mi-bridge::before {
  content: '';
  position: absolute;
  left: -7rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: var(--brand, #E8890C);
}
.mi-bridge::after {
  content: '';
  position: absolute;
  right: -7rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: var(--brand, #E8890C);
}
.mi-code {  /* 卡密：票券（圆角矩形 + 中缝虚线） */
  background: var(--brand-soft);
}
.mi-code::before {
  content: '';
  position: absolute;
  left: 6rpx; top: 8rpx;
  width: 22rpx; height: 18rpx;
  border: 2rpx solid var(--brand);
  border-radius: 4rpx;
  box-sizing: border-box;
}
.mi-code::after {
  content: '';
  position: absolute;
  left: 50%; top: 10rpx; bottom: 8rpx;
  width: 0;
  transform: translateX(-50%);
  border-left: 2rpx dashed var(--brand);
}
.mi-point::before {
  content: '';
  position: absolute;
  inset: 6rpx;
  border: 3rpx solid var(--brand);
  border-radius: 50%;
}
.mi-point::after {
  content: '';
  position: absolute;
  left: 14rpx; top: 10rpx;
  width: 3rpx; height: 14rpx;
  background: var(--brand);
}
