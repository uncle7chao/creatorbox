.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* ── 头部 ── */
.head {
  background: var(--bg-card);
  padding: 28rpx;
  display: flex;
  align-items: baseline;
}

.head-t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.head-s {
  font-size: 24rpx;
  color: var(--ink-500);
  margin-left: 20rpx;
}

/* ── 筛选 tab（素材/文案库）── */
.filter {
  background: var(--bg-card);
  padding: 0 28rpx;
  display: flex;
  gap: 40rpx;
}

.fitem {
  font-size: 26rpx;
  color: var(--ink-500);
  padding: 16rpx 0 14rpx;
}

.fitem.on {
  color: var(--brand);
  font-weight: 500;
  box-shadow: inset 0 -4rpx 0 var(--brand);
}

.fn {
  font-size: 20rpx;
  background: var(--brand-soft);
  color: #854F0B;
  border-radius: 6rpx;
  padding: 0 8rpx;
  margin-left: 4rpx;
}

/* ── 空态 ── */
.empty {
  padding: 160rpx 60rpx 0;
  text-align: center;
}

/* 空态插画：纯 CSS，不用 emoji */
.empty-art {
  width: 160rpx;
  height: 128rpx;
  margin: 0 auto 32rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.empty-line {
  height: 10rpx;
  background: var(--line);
  border-radius: 5rpx;
  margin-bottom: 14rpx;
}

.empty-line.short {
  width: 60%;
}

.empty-t {
  font-size: 30rpx;
  color: var(--ink-700);
}

.empty-s {
  font-size: 24rpx;
  color: var(--ink-500);
  margin-top: 12rpx;
}

.empty-btn {
  margin-top: 48rpx;
}

/* ── 列表项 ── */
.item {
  background: var(--bg-card);
  margin: 16rpx 24rpx;
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
}

.item-cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.item-img {
  width: 100%;
  height: 100%;
}

.item-nocover {
  width: 100%;
  height: 100%;
  background: var(--bg-soft);
}

.item-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.item-plat {
  font-size: 20rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: 5rpx;
  padding: 4rpx 10rpx;
}

.item-author {
  font-size: 22rpx;
  color: var(--ink-500);
}

.item-time {
  font-size: 22rpx;
  color: var(--ink-300);
}

.item-acts {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.item-btn {
  font-size: 22rpx;
  color: var(--brand);
  border: 1rpx solid #FFC46B;
  border-radius: 8rpx;
  padding: 8rpx 18rpx;
}

.item-btn.danger {
  color: var(--ink-300);
  border-color: var(--line);
}

/* ── 提示 ── */
.tip {
  margin: 24rpx 48rpx 0;
  font-size: 22rpx;
  color: var(--ink-300);
  line-height: 1.7;
  text-align: center;
}