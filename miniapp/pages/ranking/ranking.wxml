<!-- ══ 屏 6 · 热门榜单（M1.5）══ -->
<view class="page theme-{{theme}}">
  <theme-deco theme="{{theme}}" />

  <!-- 渐变页头（多层叠加 + 装饰圆，视觉规范第 30 轮） -->
  <view class="hero">
    <view class="deco deco-1"></view>
    <view class="deco deco-2"></view>
    <view class="hero-title">热门榜单</view>
    <view class="hero-sub">全平台热榜素材 · 点击直接解析同款</view>

    <!-- 平台 tab：已接入实心，未接入「接入中」胶囊 -->
    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{platforms}}"
        wx:key="key"
        class="tab {{item.key === activeKey ? 'tab-active' : ''}} {{item.live ? '' : 'tab-soon'}}"
        data-key="{{item.key}}"
        bindtap="onTabTap">
        <text>{{item.label}}</text>
        <text wx:if="{{!item.live}}" class="tab-soon-tag">接入中</text>
        <text wx:elif="{{item.kind === 'word'}}" class="tab-soon-tag tab-word-tag">热点</text>
      </view>
    </scroll-view>
  </view>

  <!-- 更新时间 -->
  <view wx:if="{{updatedText}}" class="updated">{{updatedText}} · 数据来自平台官方热榜</view>

  <!-- 广告位 · Banner（2026-10-08：从列表底部移到顶部，进页即见） -->
  <ad-banner placement="ranking_banner" />

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state">
    <view class="state-spinner"></view>
    <view class="state-text">榜单加载中…</view>
  </view>

  <!-- 错误 / 接入中态 -->
  <view wx:elif="{{errorMsg}}" class="state">
    <view class="state-icon">{{activeLabel}}</view>
    <view class="state-text">{{errorMsg}}</view>
    <view class="state-btn" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 榜单列表 -->
  <view wx:else class="list">
    <view
      wx:for="{{items}}"
      wx:key="rank"
      class="card"
      data-index="{{index}}"
      bindtap="onItemTap">

      <!-- 排名徽章：1-3 金银铜奖牌，其余灰底数字 -->
      <view class="rank-badge {{item.medal}}">
        <text wx:if="{{item.medal}}">{{item.rank}}</text>
        <text wx:else>{{item.rank}}</text>
      </view>

      <view class="card-main">
        <view class="card-title">{{item.title}}</view>
        <view class="card-meta">
          <text wx:if="{{item.type === 'word'}}" class="card-word-tag">热点词条</text>
          <text wx:else class="card-author">@{{item.author}}</text>
          <text class="card-hot">{{item.hot_text}}{{item.type === 'word' ? '热度' : '播放'}}</text>
        </view>
        <!-- 热度条（相对榜首） -->
        <view class="heat-track">
          <view class="heat-fill" style="width: {{item.heatPct}}%"></view>
        </view>
      </view>

      <!-- 解析同款箭头 -->
      <view class="card-go">
        <view class="go-arrow"></view>
        <text class="go-text">解析</text>
      </view>
    </view>

    <view class="list-foot">点击任意条目即可去水印解析 · 榜单每小时随官方更新</view>
  </view>

</view>
