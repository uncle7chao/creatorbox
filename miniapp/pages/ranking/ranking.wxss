/* ══ 屏 6 · 热门榜单 ══
   视觉语言对齐第 30 轮规范：多层渐变页头 / 品牌色投影 / 奖牌徽章 / 热度条
   品牌色：橙金 var(--brand) · 深棕 var(--hero-a)（与 app.json 导航栏一致） */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* ── 渐变页头（radial+linear 多层叠加，非单一线性渐变）── */
.hero {
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx 28rpx;
  background:
    radial-gradient(ellipse 600rpx 300rpx at 85% -10%, var(--glow), transparent 60%),
    radial-gradient(ellipse 500rpx 280rpx at -10% 110%, rgba(255, 255, 255, 0.14), transparent 55%),
    linear-gradient(160deg, var(--hero-a2) 0%, var(--hero-a) 55%, var(--hero-b) 100%);
}
.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.deco-1 { width: 300rpx; height: 300rpx; top: -120rpx; right: -80rpx; }
.deco-2 { width: 200rpx; height: 200rpx; bottom: -90rpx; left: -60rpx; }

.hero-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.hero-sub {
  position: relative;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* ── 平台 tab（横向滚动）── */
.tabs {
  position: relative;
  margin-top: 30rpx;
  white-space: nowrap;
}
.tab {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.12);
}
.tab-active {
  color: var(--hero-a);
  font-weight: 700;
  background: linear-gradient(135deg, var(--brand-3), var(--brand));
  box-shadow: 0 6rpx 16rpx rgba(232, 137, 12, 0.4);
}
.tab-soon { opacity: 0.55; }
.tab-soon-tag {
  margin-left: 8rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ── 更新时间 ── */
.updated {
  margin: 20rpx 32rpx 0;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* ── 加载 / 错误态 ── */
.state {
  margin: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(232, 137, 12, 0.2);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-card);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-300);
  background: var(--bg-soft-2);
}
.state-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-500);
}
.state-btn {
  margin-top: 32rpx;
  padding: 16rpx 56rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  box-shadow: 0 8rpx 20rpx rgba(232, 137, 12, 0.35);
}

/* ── 榜单列表 ── */
.list { padding: var(--sec-gap) 24rpx 0; }

.card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--r-card);
  background: var(--bg-card);
  box-shadow: var(--card-shadow);
  border: var(--card-line) solid var(--line);
}

/* 排名徽章：金银铜渐变奖牌 */
.rank-badge {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-500);
  background: var(--bg-soft-2);
}
.rank-badge.gold {
  color: #6B4A00;
  background: linear-gradient(135deg, #FFE3A0, var(--brand-2));
  box-shadow: 0 4rpx 12rpx var(--glow);
}
.rank-badge.silver {
  color: #5A6068;
  background: linear-gradient(135deg, #F0F2F5, #C3CAD3);
  box-shadow: 0 4rpx 12rpx rgba(160, 170, 182, 0.4);
}
.rank-badge.bronze {
  color: #6E3B1E;
  background: linear-gradient(135deg, #F0C4A8, #CD8A5B);
  box-shadow: 0 4rpx 12rpx rgba(205, 138, 91, 0.4);
}

.card-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 22rpx;
}
.card-author {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-500);
}
.card-hot {
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 600;
  color: var(--brand);
}

/* 热度条 */
.heat-track {
  margin-top: 14rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}
.heat-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-3), var(--brand));
}

/* 解析入口 */
.card-go {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.go-arrow {
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 16rpx solid var(--brand);
}
.go-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--brand-ink);
}

.list-foot {
  margin: 24rpx 0 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-300);
}

/* 热点词条标识（抖音词榜：点击复制去搜，非解析同款） */
.card-word-tag {
  font-size: 18rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.tab-word-tag {
  color: var(--brand);
  background: var(--brand-soft);
}
