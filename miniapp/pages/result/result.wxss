/**
 * 屏 2 · 结果页样式
 *
 * 关键设计约束（来自规范）：
 *   · 实线 = 强制，虚线 = 可选（不虚线化会让用户觉得被强迫）
 *   · 1080P 用琥珀色不用灰 —— 免费拿不到的高亮才是「差一点点」的钩子
 *   · 两个虚线按钮并排，视觉权重相同
 *   · 免责灰字 11px
 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 48rpx;
}

/* ── 加载 / 丢失 ── */
.loading {
  padding: 200rpx 0;
  text-align: center;
}

.spin {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 24rpx;
  border: 5rpx solid var(--bg-soft);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-t {
  font-size: 28rpx;
  color: var(--ink-500);
}

.lost {
  padding: 160rpx 48rpx;
  text-align: center;
}

.lost-t {
  font-size: 30rpx;
  color: var(--ink-500);
  margin-bottom: 40rpx;
}

/* ── 顶部信息栏 ── */
.topbar {
  background: var(--bg-card);
  padding: 28rpx 28rpx 24rpx;
  display: flex;
  align-items: flex-start;
}

.topbar-l {
  flex: 1;
  min-width: 0;
}

.topbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.4;
  /* 超长省略（规范要求） */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.topbar-sub {
  font-size: 24rpx;
  color: var(--ink-500);
  margin-top: 10rpx;
}

/* 绿底「无水印」徽章 */
.wm-badge {
  background: #1B8A5A;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 标题来源提示 */
.hint {
  margin: 0 28rpx 16rpx;
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

/* 平台特有提示（琥珀条） */
.notice {
  margin: 0 28rpx 16rpx;
  font-size: 24rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

/* ── 预览区 ── */
.video-wrap {
  margin: 20rpx 28rpx;
  position: relative;
  width: 100%;
  /* 16:9 用 padding-top技巧（小程序支持） */
  height: 400rpx;
  background: var(--ink-900);
  border-radius: 14rpx;
  overflow: hidden;
}

.video-cover {
  width: 100%;
  height: 100%;
}

.video-nocover {
  width: 100%;
  height: 100%;
  background: #2b2622;
}

/* 播放三角：纯 CSS，不用 emoji */
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  margin-left: -30rpx;
  margin-top: -40rpx;
  border-left: 60rpx solid rgba(255, 255, 255, 0.9);
  border-top: 40rpx solid transparent;
  border-bottom: 40rpx solid transparent;
}

/* 图集网格 */
.grid {
  margin: 20rpx 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cell {
  width: calc((100% - 16rpx) / 3);
  height: 220rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--bg-soft);
}

.cell-img {
  width: 100%;
  height: 100%;
}

/* ── 互动数据 ── */
.stats {
  margin: 24rpx 28rpx 0;
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 24rpx 0;
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-n {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.stat-l {
  display: block;
  font-size: 22rpx;
  color: var(--ink-500);
  margin-top: 6rpx;
}

/* ── 文案卡（双产出，P0）── */
.copycard {
  margin: 12rpx 28rpx 0;
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
}

.cc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cc-t {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-900);
}

.cc-btn {
  font-size: 22rpx;
  color: var(--brand-deep);
  border: 1rpx solid #FFC46B;
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
  background: var(--brand-soft);
}

.cc-body {
  font-size: 24rpx;
  color: var(--ink-700);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cc-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cc-tag {
  font-size: 20rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

/* ── 保存区（双按钮：保存 + 广告解锁）── */
.save-btn {
  margin: 24rpx 28rpx 0;
  display: flex;
  gap: 16rpx;
}

/* ── 话题标签 ── */
.tags {
  margin: 20rpx 28rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
}

/* ── 清晰度 ── */
.sec-title {
  margin: 32rpx 28rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
  display: flex;
  align-items: baseline;
}

.sec-note {
  font-size: 22rpx;
  color: var(--ink-500);
  font-weight: 400;
  margin-left: 16rpx;
}

.quals {
  margin: 0 28rpx;
  display: flex;
  gap: 16rpx;
}

.qual {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--line);
  background: var(--bg-card);
  color: var(--ink-700);
}

/* 实线 = 强制：当前选中的免费档 */
.qual-on {
  background: var(--brand-deep);
  border-color: var(--brand-deep);
  color: #FFFFFF;
}

/* 虚线 = 可选 + 琥珀色（免费拿不到的高亮） */
.qual-locked {
  border: 1rpx dashed var(--brand);
  color: var(--brand);
  background: var(--bg-card);
}

/* ── 两个虚线按钮 ── */
.ad-acts {
  margin: 28rpx 28rpx 0;
  display: flex;
  gap: 16rpx;
}

.ad-btn {
  flex: 1;
  text-align: center;
  border: 1rpx dashed var(--brand);
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--bg-card);
}

/* ── 保存主按钮 ── */
.save-btn {
  margin: 28rpx 28rpx 0;
}

.quota-tip {
  margin: 16rpx 28rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-500);
}

.quota-tip-go {
  color: var(--brand);
  margin-left: 8rpx;
}

/* ── Banner 广告位 ── */
.banner {
  margin: 32rpx 28rpx 0;
  height: 200rpx;
  background: var(--bg-soft);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-t {
  font-size: 22rpx;
  color: var(--ink-300);
}

/* ── 免责灰字 ── */
.disclaimer {
  margin: 28rpx 48rpx 0;
  font-size: 22rpx;
  color: var(--ink-300);
  line-height: 1.7;
  text-align: center;
}
/* ══ BGM 卡（2026-10-11：试听 + 提取）══ */
.bgm {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: var(--r-card);
  background: var(--bg-soft, #f6f1e9);
  border: 1rpx solid var(--line, #f0ebe2);
}
.bgm-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.bgm-on { opacity: 0.75; }
.bgm-tri {
  width: 0; height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 15rpx solid #fff;
  margin-left: 5rpx;
}
.bgm-on .bgm-tri {
  width: 8rpx; height: 24rpx;
  border-left: 8rpx solid #fff;
  border-right: 8rpx solid #fff;
  border-top: none; border-bottom: none;
  margin-left: 0;
}
.bgm-body { flex: 1; min-width: 0; }
.bgm-t {
  font-size: 26rpx; font-weight: 700;
  color: var(--ink-900, #2a2a2a);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.bgm-s { margin-top: 2rpx; font-size: 20rpx; color: var(--ink-300, #b8b8b8); }
.bgm-copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brand, #E8890C);
  border: 1rpx solid var(--brand, #E8890C);
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
}


/* ══ 字幕文案卡（2026-10-11：YouTube/FB）══ */
.cc-btns { display: flex; align-items: center; }
.cc-btn-main {
  background: var(--brand, #E8890C);
  color: #fff;
  border-color: var(--brand, #E8890C);
  margin-left: 12rpx;
}
.cc-sub { max-height: 300rpx; overflow: hidden; position: relative; }
.cc-submeta {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink-300, #b8b8b8);
}

/* ══════════════════════════════════════════════════════════
   2026-10-22 竞品对齐三件套
   ① .done-line  解析完成 + 「数据不做存储」提示（合规护身符）
   ② .video-meta 视频卡右下角信息浮层（时长 + 文件大小）
   ③ 档位区已降级为紧凑行（见 WXML 注释），主 CTA 唯一
   ══════════════════════════════════════════════════════════ */

/* ── ① 解析完成提示行 ── */
.done-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 4rpx 28rpx 0;
}
/* 对勾：纯 CSS 画的（项目规范：不用 emoji/字符图标）*/
.done-tick {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: var(--ink-700);
  position: relative;
  flex-shrink: 0;
}
.done-tick::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 6rpx;
  height: 11rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(42deg);
}
.done-ok {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-700);
}
.done-note {
  font-size: 22rpx;
  color: var(--ink-500);
}

/* ── ② 视频卡信息浮层（右下角）── */
.video-meta {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  /* 半透明黑底：压在封面上仍可读，不抢播放按钮的视觉重心 */
  background: rgba(0, 0, 0, 0.55);
}
.video-meta-i {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.4;
}

/* ══════════════════════════════════════════════════════════
   素材清单（2026-10-22 竞品对齐）
   竞品的做法：按素材类型横切，每行 = 类型 + 明确动作。
   纵向堆叠时代，用户要自己拼「哪一步能拿到什么」；
   这张清单一次说清：这条链接能产出哪几类素材，各自怎么拿。
   ⭐ 图标全部 CSS 绘制（项目规范：不用 emoji、不用图片资源）
   ══════════════════════════════════════════════════════════ */
.assets {
  margin: 0 28rpx 8rpx;
  background: var(--bg-card);
  border-radius: var(--r-card);
  border: 1rpx solid var(--card-line);
  overflow: hidden;
}
.as-head {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-700);
  padding: 18rpx 24rpx 10rpx;
}
.as-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 10rpx 24rpx;
  border-top: 1rpx solid var(--card-line);
}
/* 类型图标：40rpx 方块，纯 CSS 图形 */
.as-ic {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: var(--brand-soft);
  margin-right: 18rpx;
  position: relative;
  flex-shrink: 0;
}
/* 视频：播放三角（border 法画实心三角，无 emoji 无图片） */
.as-tri {
  position: absolute;
  left: 14rpx; top: 12rpx;
  width: 0; height: 0;
  border-left: 15rpx solid var(--brand);
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
}
/* 封面：相框（外框 + 内山形，用两条线做 mountains） */
.as-img {
  position: absolute;
  left: 9rpx; top: 9rpx;
  width: 22rpx; height: 22rpx;
  border: 2rpx solid var(--brand);
  border-radius: 3rpx;
  box-sizing: border-box;
}
.as-img::after {
  content: '';
  position: absolute;
  left: 2rpx; bottom: 2rpx;
  width: 12rpx; height: 8rpx;
  /* 两座山峰：CSS 三角形拼出山形轮廓 */
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 8rpx solid var(--brand);
}
/* 文案：三条横线 */
.as-txt {
  position: absolute;
  left: 9rpx; top: 12rpx;
  width: 22rpx; height: 16rpx;
  background-image: linear-gradient(var(--brand), var(--brand)),
                    linear-gradient(var(--brand), var(--brand)),
                    linear-gradient(var(--brand), var(--brand));
  background-size: 100% 2rpx;
  background-position: 0 0, 0 7rpx, 0 13rpx;
  background-repeat: no-repeat;
}
/* BGM：音符（圆头 + 竖杆） */
.as-wave {
  position: absolute;
  left: 12rpx; top: 8rpx;
  width: 16rpx; height: 16rpx;
  border-left: 2rpx solid var(--brand);
  border-bottom: 2rpx solid var(--brand);
  box-sizing: border-box;
}
.as-wave::before {
  content: '';
  position: absolute;
  left: -3rpx; top: 8rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--brand);
}
.as-wave::after {           /* 音符右上那一横 */
  content: '';
  position: absolute;
  left: 12rpx; top: 0;
  width: 6rpx; height: 2rpx;
  background: var(--brand);
}

.as-name {
  font-size: 26rpx;
  color: var(--ink-900);
  width: 130rpx;
  flex-shrink: 0;
}
.as-acts {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}
/* 次级动作 = 文字链（对齐竞品：不是每个动作都抢按钮） */
.as-act {
  font-size: 23rpx;
  color: var(--brand-deep);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}
/* 每个类型只给一个主动作，其余为文字链 —— 避免整屏都是按钮 */
.as-act-main {
  background: var(--brand-soft);
  border: 1rpx solid #FFC46B;
  font-weight: 600;
}
