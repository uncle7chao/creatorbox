.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-bottom: 16rpx;
}

.p {
  font-size: 26rpx;
  color: var(--ink-700);
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.p:last-child {
  margin-bottom: 0;
}

.li {
  font-size: 26rpx;
  color: var(--ink-700);
  line-height: 1.9;
}

.acts {
  margin-top: 32rpx;
}

.act {
  text-align: center;
  background: var(--brand);
  color: var(--ink-900);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
}

.act-ghost {
  background: var(--bg-card);
  color: var(--ink-700);
  border: 1rpx solid var(--line);
  font-weight: 400;
}

.ver {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-300);
  margin-top: 40rpx;
}