# CreatorBox 服务端环境变量
# 位置：/etc/creatorbox/env   （权限建议 chmod 600，owner www）
#
# ⭐ 为什么单独放文件而不是写进 service：
#   systemctl show creatorbox 会把 Environment 的值全部打印出来，
#   密钥写进 service 等于半公开。放 env 文件 + EnvironmentFile=- 引用更安全。
#
# ⭐ 注意：systemd 的 EnvironmentFile 不支持 export 前缀，也不支持
#   引号包裹的复杂值（值里有空格时用引号可以，但别写 export）。
#   改完必须 restart 才生效：sudo systemctl restart creatorbox

# ── 必配：管理接口密钥 ───────────────────────────────────────────
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 不配 → 所有 /api/admin/* 返回 503 锁死（安全设计，非故障）
CB_API_KEY=

# ── 微信小程序 ─────────────────────────────────────────────────
# 不配则小程序登录走游客模式（功能可用，但会员/跨端绑定不可用）
CB_WX_APPID=
CB_WX_SECRET=

# ── 数据与网络 ─────────────────────────────────────────────────
CB_DB_PATH=/www/creatorbox/server/data/cb.db
CB_HOST=127.0.0.1
CB_PORT=8080

# ── 平台开关 ───────────────────────────────────────────────────
# full = 全平台；review = 提审收敛（只保留抖音+B站入口）
CB_REVIEW_MODE=full
# 国际平台（TikTok/X/YT/FB）：大陆部署建议 0
CB_INTL_ENABLED=0
# 浏览器通道（小红书热榜 / 解析兜底）：需要 playwright chromium
CB_BROWSER_CHANNEL=1
CB_BROWSER_FALLBACK=0
CB_HEADLESS=1

# ── 健康探针 ───────────────────────────────────────────────────
CB_ENABLE_HEALTH=1
CB_HEALTH_INTERVAL=600

# ── Cookie（可选，从浏览器 F12 复制）────────────────────────────
# CB_XHS_COOKIE=
# CB_WEIBO_COOKIE=
# CB_BILI_COOKIE=

# ── 告警（可选）：探针连续失败时推送 ───────────────────────────
# CB_ALERT_WEBHOOK=

# ── Redis（可选）：多实例限流时需要；单实例可留空 ─────────────
# CB_REDIS_URL=
