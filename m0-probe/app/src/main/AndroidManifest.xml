<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M0-V1 探针需要读剪贴板、访问网络（探测短链） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 11+ 需要显式声明可见性 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_share"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CBProbe">

        <!--
          ⚠️ 关键：两个 intent-filter 必须分开写

          错误写法（分享会被系统静默忽略）：
            <intent-filter>
              <action MAIN /> <action SEND />
              <category LAUNCHER /> <category DEFAULT />
            </intent-filter>

          原因：系统按 filter 整体匹配，一个 filter 同时含 MAIN 和 SEND 时，
          微信的分享 Intent（只含 SEND + DEFAULT）匹配不上任何 filter，
          结果就是不显示在分享面板里。
        -->

        <!-- 启动入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 文本分享（抖音/小红书/快手的链接文本走这里） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 多项文本分享 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 图片分享（素材直接分享，可能也是入口） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- 视频分享（部分平台走 video/* 而非图片） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Android 12+ 必须显式声明 exported -->
    </application>
</manifest>
