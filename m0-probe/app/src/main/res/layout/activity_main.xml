<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#FFFFFF">

    <Button
        android:id="@+id/btn_probe_self"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="1. 自检注册状态"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_read_clipboard" />

    <Button
        android:id="@+id/btn_read_clipboard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:text="2. 读剪贴板"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_probe_self"
        app:layout_constraintEnd_toStartOf="@id/btn_copy" />

    <Button
        android:id="@+id/btn_copy"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:text="3. 复制"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_read_clipboard"
        app:layout_constraintEnd_toStartOf="@id/btn_clear" />

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:text="4. 清空"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_copy"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/input"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#F5F5F5"
        android:hint="手动粘贴链接测试区（可粘贴后观察下方解析日志）"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/btn_probe_self"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toBottomOf="@id/input"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#9CDCFE"
            android:textIsSelectable="true"
            android:textSize="10sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
